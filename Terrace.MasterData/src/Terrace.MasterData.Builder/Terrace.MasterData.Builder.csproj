<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>masterdata-build</AssemblyName>
    <RootNamespace>Terrace.MasterData</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Shared はテーブル定義の唯一の正。独立した csproj にはせず、ここからグロブで取り込む。
       将来 Unity とサーバーからも同じファイルを参照する。 -->
  <ItemGroup>
    <Compile Include="../Shared/**/*.cs" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MasterMemory" Version="3.0.4" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

</Project>
