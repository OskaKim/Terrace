<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity を使わずに、Client の Core(ゲーム規則)と EditMode テストを .NET で回すためのプロジェクト。
    ソースは Assets の中のものをそのまま取り込む(複製しない)。Unity が使う同期済みの写し(Assets/Terrace/Shared)を
    コンパイルするので、Unity でコンパイルされるものと同じコードを試すことになる。

    取り込まないもの: Unity の API を使うテスト(ArtAssetsTests、AudioAssetsTests、MapAssetsTests)。それらは Unity の EditMode でだけ回す。
    NUnit は Unity の Test Framework に合わせて 3 系(Assert.AreEqual などの古い書き方が使える)。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Terrace.Client.Tests.EditMode</RootNamespace>
    <!-- Core の InternalsVisibleTo と同じ名前にしておく -->
    <AssemblyName>Terrace.Client.Tests.EditMode</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Terrace/Runtime/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Terrace/Shared/Map/*.cs" Link="Shared/Map/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Terrace/Shared/Protocol/**/*.cs" Link="Shared/Protocol/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Tests/EditMode/*.cs"
             Exclude="../../Assets/Tests/EditMode/ArtAssetsTests.cs;../../Assets/Tests/EditMode/AudioAssetsTests.cs;../../Assets/Tests/EditMode/MapAssetsTests.cs"
             Link="Tests/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- 通信の定義(Terrace.Shared の写し)が使う -->
    <PackageReference Include="MagicOnion.Abstractions" Version="7.10.2" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

</Project>
